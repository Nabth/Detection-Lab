# SYN Flood (stateful, нужна проверка потока)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM Possible SYN Flood"; flags:S; threshold: type both, track by_src, count 200, seconds 5; classtype:attempted-dos; sid:1000001; rev:6;)

# UDP Flood (stateful)
alert udp any any -> $HOME_NET any (msg:"CUSTOM Possible UDP Flood"; threshold: type both, track by_src, count 500, seconds 5; classtype:attempted-dos; sid:1000002; rev:6;)

# XMAS Scan (stateless)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM TCP Flag Anomaly Scan (XMAS)"; flow:stateless; flags:FPU; threshold: type both, track by_src, count 10, seconds 10; classtype:attempted-recon; sid:1000003; rev:7;)

# NULL Scan (stateless)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM TCP Flag Anomaly Scan (NULL)"; flags:!S; flow:stateless; threshold: type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000004; rev:3;)

# FIN Scan (stateless)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM TCP Flag Anomaly Scan (FIN)"; flow:stateless; flags:F; threshold: type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000005; rev:2;)
