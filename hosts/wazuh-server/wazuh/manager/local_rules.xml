<!-- ================================================================== -->
<!-- GROUP: Coraza WAF (L7 Web Application Firewall)                    -->
<!-- ================================================================== -->
<group name="coraza,waf,">
  <!-- Базовое правило для сбора всех логов Coraza (level 0, чтобы не спамить) -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="transaction.id">\.+</field>
    <description>Coraza WAF Audit Log</description>
    <options>no_full_log</options>
  </rule>

  <!-- Правило: WAF заблокировал запрос -->
  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="transaction.is_interrupted">true</field>
    <description>Coraza WAF: Attack blocked from $(transaction.client_ip) on $(transaction.request.uri)</description>
    <mitre><id>T1190</id></mitre>
    <group>attack,web_attack,</group>
  </rule>

  <!-- Дополнительное правило: уточняем, что это именно SQLi -->
  <rule id="100104" level="12">
    <if_sid>100101</if_sid>
    <regex>SQL Injection Attack Detected</regex>
    <description>Coraza WAF: SQL Injection blocked from $(transaction.client_ip)</description>
    <mitre><id>T1190</id></mitre>
    <group>attack,sql_injection,</group>
  </rule>
</group>

<!-- ================================================================== -->
<!-- GROUP: Nginx L7 (Web Brute Force & HTTP Flood)                     -->
<!-- ================================================================== -->
<group name="nginx,web,">
  <!-- База: Ловим POST-запросы к login.php (привязка к SID 31141) -->
  <rule id="100102" level="3">
    <!-- Привязываемся ко всем базовым правилам веб-логов (2xx, 3xx, 4xx, 5xx, 499) -->
    <if_sid>31100,31101,31102,31108,31141</if_sid> 
    <match>login.php</match>
    <description>DVWA: Login page request</description>
  </rule>

  <!-- Корреляция: 5 таких запросов за 60 секунд = Брутфорс -->
<rule id="100103" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100102</if_matched_sid>
    <same_source_ip />
    <description>Brute Force Attack detected on DVWA login page from $(srcip)</description>
    <mitre><id>T1110</id></mitre>
    <group>web_attack,brute_force,active_response,</group>
  </rule>

  <!-- Nginx HTTP Flood (429 Too Many Requests) -->
<rule id="100300" level="10">
   <if_sid>31100</if_sid>
   <id>429</id>
   <description>Nginx: HTTP Flood detected (429 Too Many Requests) from $(srcip)</description>
   <mitre><id>T1498.001</id></mitre>
   <group>web_attack,ddos,active_response,</group>
  </rule>

  <!-- Nginx Slowloris -->
<rule id="100302" level="10">
  <decoded_as>nginx-errorlog-timeout</decoded_as>
  <description>Nginx: Slowloris Attack detected via error.log (client timeout from $(srcip))</description>
  <mitre><id>T1498.001</id></mitre>
  <group>web_attack,ddos,active_response,</group>
</rule>
</group>

<!-- ================================================================== -->
<!-- GROUP: Suricata L3/L4 (Network DDoS & Scans)                       -->
<!-- ================================================================== -->
<group name="suricata,network,">
  <!-- SYN Flood -->
  <rule id="100200" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">1000001</field>
    <description>Suricata: Custom SYN Flood detected.</description>
    <mitre><id>T1498.001</id></mitre>
    <group>ddos,syn_flood,active_response,</group>
  </rule>

  <!-- UDP Flood -->
  <rule id="100201" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">1000002</field>
    <description>Suricata: Custom UDP Flood detected.</description>
    <mitre><id>T1498.002</id></mitre>
    <group>ddos,udp_flood,active_response,</group>
  </rule>

  <!-- TCP Flag Scans (XMAS/NULL/FIN) -->
  <rule id="100202" level="10">
    <if_sid>86601</if_sid>
    <regex>CUSTOM TCP Flag Anomaly Scan</regex>
    <description>Suricata: TCP Flag Anomaly Scan (XMAS/NULL/FIN).</description>
    <mitre><id>T1046</id></mitre>
    <group>scan,tcp_anomaly,active_response,</group>
  </rule>

  <!-- Nmap Scans -->
  <rule id="100203" level="7">
    <if_sid>86601</if_sid>
    <regex>ET SCAN</regex>
    <description>Suricata: Port Scan detected.</description>
    <mitre><id>T1046</id></mitre>
    <group>scan,port_scan,active_response,</group>
  </rule>

  <!-- ICMP Flood -->
  <rule id="100204" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">1000009</field>
    <description>Suricata: Custom ICMP Flood detected.</description>
    <mitre><id>T1498.001</id></mitre>
    <group>ddos,icmp_flood,active_response,</group>
  </rule>

  <!-- ACK Flood -->
  <rule id="100205" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">1000010</field>
    <description>Suricata: Custom ACK Flood detected.</description>
    <mitre><id>T1498.001</id></mitre>
    <group>ddos,ack_flood,active_response,</group>
  </rule>

  <!-- RST Flood -->
  <rule id="100206" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">1000011</field>
    <description>Suricata: Custom RST Flood detected.</description>
    <mitre><id>T1498.001</id></mitre>
    <group>ddos,rst_flood,active_response,</group>
  </rule>

  <!-- LAND Attack / Invalid TCP Flags -->
  <rule id="100207" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">100001[2-4]</field>
    <description>Suricata: LAND Attack or Invalid TCP Flags detected.</description>
    <mitre><id>T1498.001</id></mitre>
    <group>ddos,invalid_flags,active_response,</group>
  </rule>
</group>
