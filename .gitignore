# ============================================================
# SOC Lab specific ignores
# ============================================================

# --- Secrets and credentials (CRITICAL) ---
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.yaml
secrets.yml

# --- Wazuh keys ---
client.keys
authd.pass

# --- Security tool logs (huge, ephemeral) ---
eve.json
alerts.json
archives.json
fast.log
stats.log
suricata.log
modsec_audit.log
modsec_debug.log

# --- Traffic captures and raw artifacts ---
*.pcap
*.pcapng
reports/raw/
reports/*/raw/
reports/sqlmap/

# --- Test fixtures (small, curated logs — MUST be tracked) ---
!analysis/tests/fixtures/**/*.log
!analysis/tests/fixtures/**/eve_sample.json
!analysis/tests/fixtures/**/alerts_sample.json

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================================
# Project-specific ignores (v1.0 restructure)
# ============================================================

# WAF certificates (never commit private keys)
hosts/victim/waf-coraza/certs/
*.pem
*.key

# Testing results
testing/results/*
!testing/results/.gitkeep

# Docker overrides
docker-compose.override.yml

# Wazuh local copies
hosts/wazuh-server/wazuh/manager/client.keys

